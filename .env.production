# ============================================================
# 生产环境变量（npm run build 自动加载）
# 上线前必须把下面的地址改成真实后端！
# ============================================================

VUE_APP_ENV=production

# TODO-API 生产后端接口地址
# 所有请求会拼成：VUE_APP_BASE_API + 接口路径
# 例：getCartList() -> https://your-api.example.com/cart/list
VUE_APP_BASE_API=https://your-api.example.com
