# ============================================================
# 开发环境变量（npm run serve 自动加载）
# ============================================================

# 环境标识
VUE_APP_ENV=development

# 后端接口基地址
# 开发时以 /api 开头，由 vue.config.js 的 devServer.proxy 转发
# 实际请求：/api/cart/list  ->  http://localhost:3000/cart/list
VUE_APP_BASE_API=/api
